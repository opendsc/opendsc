@rendermode InteractiveServer

@using System.Text.Json
@using System.Text.Json.Nodes
@using OpenDsc.Contracts.DscFunctions
@using OpenDsc.Server.Services

@inject IDscFunctionService FunctionService
@inject IDialogService DialogService

<MudDialog Style="width: min(1280px, 96vw); height: min(88vh, 900px); display: flex; flex-direction: column;">
    <DialogContent>
        <MudGrid Style="height: 100%; min-height: 0;">
            @if (!PreviewOnly)
            {
            <MudItem xs="12" md="4" Style="min-height: 0;">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Function</MudText>
                @if (!_isLoaded)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">Loading functions...</MudAlert>
                }
                else
                {
                    <MudTextField T="string" @bind-Value="_search" Placeholder="Search..."
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Immediate="true" Class="mb-2" />
                    <MudSelect T="string" @bind-Value="_selectedCategory" Label="Category"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Clearable="true">
                        @foreach (var category in GetAvailableCategories())
                        {
                            <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                        }
                    </MudSelect>
                    <MudList T="string" Dense="true" Class="pa-0" Style="max-height: calc(10 * 2.25rem + 0.5rem); overflow-y: auto;">
                        @foreach (var fn in FilteredFunctions)
                        {
                            <MudListItem T="string"
                                         Class="@(_selectedFunction?.Name == fn.Name ? "mud-selected-item" : "")"
                                         OnClick="@(() => SelectFunction(fn))">
                                <MudText Typo="Typo.body2" Style="font-family: monospace;">@fn.Name</MudText>
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudItem>
            }

            <MudItem xs="12" md="@(PreviewOnly ? 12 : 8)" Style="min-height: 0;">
                @if (_selectedFunction is not null)
                {
                    @if (!PreviewOnly)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-1" Style="font-family: monospace;">
                            @{
                                var _funcSig = $"{_selectedFunction.Name}({string.Join(", ", _selectedFunction.ParameterTypes)})";
                            }
                            @_funcSig
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(_selectedFunction.Description))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                                @_selectedFunction.Description
                            </MudText>
                        }

                        <MudText Typo="Typo.subtitle2" Class="mb-2">Arguments</MudText>

                        @for (int i = 0; i < _args.Count; i++)
                        {
                            var idx = i;
                            <MudPaper Outlined="true" Class="pa-2 mb-2">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudSelect T="string" Label="Source"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Disabled="@IsArgKindLockedToNested(idx)"
                                                   Value="@(_args[idx].IsNested ? NestedArgKind : LiteralArgKind)"
                                                   ValueChanged="@(v => ChangeArgKind(idx, v))">
                                            <MudSelectItem T="string" Value="@LiteralArgKind">Literal</MudSelectItem>
                                            <MudSelectItem T="string" Value="@NestedArgKind">Nested function</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="7">
                                        @if (_args[idx].IsNested)
                                        {
                                            <div class="d-flex align-center gap-2 flex-wrap">
                                                @if (_args[idx].NestedFunction is null)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Not configured</MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Functions">
                                                        @_args[idx].NestedFunction!.FunctionName
                                                    </MudChip>
                                                }
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                           StartIcon="@Icons.Material.Filled.AccountTree"
                                                           OnClick="@(() => ConfigureNestedFunction(idx))">
                                                    @(_args[idx].NestedFunction is null ? "Add nested function" : "Edit nested function")
                                                </MudButton>
                                                @if (_args[idx].NestedFunction is not null)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                   Size="Size.Small"
                                                                   Color="Color.Error"
                                                                   OnClick="@(() => ClearNestedFunction(idx))" />
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            if (TryGetLiteralOptions(idx, out var literalOptions, out var literalPlaceholder))
                                            {
                                                <MudAutocomplete T="string"
                                                                 Label="@GetArgumentLabel(idx)"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Value="@_args[idx].LiteralInput"
                                                                 ValueChanged="@(v => OnArgChanged(idx, v ?? string.Empty))"
                                                                 SearchFunc="@((text, ct) => SearchLiteralOptions(idx, text))"
                                                                 CoerceText="true"
                                                                 Immediate="true"
                                                                 Placeholder="@literalPlaceholder" />
                                            }
                                            else
                                            {
                                                <MudTextField T="string"
                                                              Label="@GetArgumentLabel(idx)"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Value="@_args[idx].LiteralInput"
                                                              ValueChanged="@(v => OnArgChanged(idx, v))"
                                                              Immediate="true"
                                                              Placeholder="@literalPlaceholder" />
                                            }
                                        }
                                    </MudItem>
                                    <MudItem xs="1" Class="d-flex align-center justify-center">
                                        @if (_args.Count > GetEffectiveMinArgs())
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => RemoveArgAt(idx))" />
                                        }
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        }

                        @if (GetEffectiveMaxArgs() is null || _args.Count < GetEffectiveMaxArgs())
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddArg">Add argument</MudButton>
                        }

                        <MudDivider Class="my-3" />
                    }

                    <MudText Typo="Typo.subtitle2" Class="mb-1">Function Composition</MudText>
                    <div style="border: 1px solid var(--mud-palette-lines-default); border-radius: 4px; padding: 8px; background: var(--mud-palette-background-grey); overflow: auto; max-height: 260px;">
                        @if (BuildCompositionTree() is { } previewTree)
                        {
                            @RenderCompositionNode(previewTree, 0)
                        }
                    </div>

                    @if (HasPreviewMocks)
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Mock Values (for preview)</MudText>

                        <MudExpansionPanels>
                            @if (_usage?.EnvVars.Count > 0)
                            {
                                <MudExpansionPanel Text="Environment Variables" Expanded="true">
                                    @foreach (var name in _usage.EnvVars.OrderBy(n => n, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <MudTextField T="string" Label="@name" Value="@GetMockEnvVar(name)"
                                                      ValueChanged="@(value => SetMockEnvVar(name, value))"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Immediate="true" />
                                    }
                                </MudExpansionPanel>
                            }

                            @if (_usage?.Parameters.Count > 0)
                            {
                                <MudExpansionPanel Text="Parameters" Expanded="true">
                                    @foreach (var name in _usage.Parameters.OrderBy(n => n, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <MudTextField T="string" Label="@name" Value="@GetMockParameter(name)"
                                                      ValueChanged="@(value => SetMockParameter(name, value))"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Immediate="true" />
                                    }
                                </MudExpansionPanel>
                            }

                            @if (_usage?.Variables.Count > 0)
                            {
                                <MudExpansionPanel Text="Variables" Expanded="true">
                                    @foreach (var name in _usage.Variables.OrderBy(n => n, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <MudTextField T="string" Label="@name" Value="@GetMockVariable(name)"
                                                      ValueChanged="@(value => SetMockVariable(name, value))"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Immediate="true" />
                                    }
                                </MudExpansionPanel>
                            }

                            @if (_referenceTargets.Count > 0)
                            {
                                <MudExpansionPanel Text="Referenced Resources" Expanded="true">
                                    @foreach (var reference in _referenceTargets)
                                    {
                                        <MudPaper Outlined="true" Class="pa-2 mb-2">
                                            <MudText Typo="Typo.body2" Class="mb-2">@reference.DisplayLabel</MudText>
                                            <JsonInlineEditor InitialValue="@GetMockReferenceOutput(reference.Key)"
                                                              ValueApplied="@(value => SetMockReferenceOutput(reference.Key, value))" />
                                        </MudPaper>
                                    }
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    }

                    @if (_previewResult is not null)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Preview</MudText>
                        <div style="background: var(--mud-palette-background-grey); padding: 8px; border-radius: 4px; font-family: monospace; font-size: 0.85rem;">
                            @if (_previewResult.Success)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Result</MudText>
                                <MudText Color="Color.Success" Style="font-family: monospace;">@_previewResult.ResultJson</MudText>
                            }
                            else
                            {
                                <MudText Color="Color.Error" Typo="Typo.caption">@_previewResult.Error</MudText>
                            }

                            <MudExpansionPanels Class="mt-2">
                                <MudExpansionPanel Text="Raw expression">
                                    <MudText Style="font-family: monospace; word-break: break-all;">@_previewResult.FunctionExpression</MudText>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        </div>
                    }

                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PlayArrow"
                               Color="Color.Primary" OnClick="RunPreview" Class="mt-1">
                        Mock preview
                    </MudButton>
                }
                else
                {
                    <MudText Color="Color.Secondary" Typo="Typo.body2">
                        @(PreviewOnly ? "No function expression is available for preview." : "Select a function to configure its arguments.")
                    </MudText>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        @if (PreviewOnly)
        {
            <MudButton OnClick="Cancel">Close</MudButton>
        }
        else
        {
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Insert"
                       Disabled="@(_selectedFunction is null)">
                Insert
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>
    /// Pre-populated parameter names from the current config document, used for mock hints.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string> ParameterNames { get; set; } = [];

    /// <summary>
    /// Pre-populated variable names from the current config document, used for mock hints.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string> VariableNames { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> AvailableTypes { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ResourceReferenceOption> ResourceReferences { get; set; } = [];

    [Parameter]
    public DscFunctionExpression? ExistingExpression { get; set; }

    [Parameter]
    public bool PreviewOnly { get; set; }

    private const string LiteralArgKind = "literal";
    private const string NestedArgKind = "nested";

    private bool _isLoaded;
    private IReadOnlyList<DscFunctionInfo> _allFunctions = [];
    private string _search = string.Empty;
    private string _selectedCategory = string.Empty;
    private DscFunctionInfo? _selectedFunction;
    private List<ArgEditorState> _args = [];
    private readonly Dictionary<string, string> _mockEnvVars = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _mockParams = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _mockVariables = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _mockReferenceOutputs = new(StringComparer.Ordinal);
    private FunctionPreviewUsage? _usage;
    private List<ReferenceTarget> _referenceTargets = [];
    private EvaluateDscFunctionResult? _previewResult;

    private bool HasPreviewMocks =>
        _usage is not null && (
            _usage.EnvVars.Count > 0 ||
            _usage.Parameters.Count > 0 ||
            _usage.Variables.Count > 0 ||
            _referenceTargets.Count > 0);

    private IEnumerable<DscFunctionInfo> FilteredFunctions
    {
        get
        {
            var filtered = _allFunctions.AsEnumerable();

            // Filter by category
            if (!string.IsNullOrWhiteSpace(_selectedCategory))
            {
                filtered = filtered.Where(f => f.Categories.Contains(_selectedCategory, StringComparer.OrdinalIgnoreCase));
            }

            // Filter by search text
            if (!string.IsNullOrWhiteSpace(_search))
            {
                filtered = filtered.Where(f =>
                    f.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (f.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true));
            }

            // Sort by name
            return filtered.OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase);
        }
    }

    private IEnumerable<string> GetAvailableCategories()
    {
        return _allFunctions
            .SelectMany(f => f.Categories)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        // Load functions from the service asynchronously
        _allFunctions = await FunctionService.GetFunctionsAsync();
        _isLoaded = true;

        if (ExistingExpression is null)
        {
            RefreshPreviewMetadata();
            return;
        }

        var fn = _allFunctions
            .FirstOrDefault(f => string.Equals(f.Name, ExistingExpression.FunctionName, StringComparison.OrdinalIgnoreCase));

        if (fn is null)
        {
            return;
        }

        _selectedFunction = fn;
        _args = ExistingExpression.Args
            .Select(a => new ArgEditorState
            {
                IsNested = a.IsNested,
                NestedFunction = a.NestedFunction,
                LiteralInput = FormatLiteralInput(a.LiteralValue)
            })
            .ToList();

        EnsureMinArgs();
        NormalizeArgsForSelectedFunction();
        RefreshPreviewMetadata();
    }

    private void SelectFunction(DscFunctionInfo fn)
    {
        _selectedFunction = fn;
        _args = string.Equals(fn.Name, "reference", StringComparison.OrdinalIgnoreCase)
            ? [new ArgEditorState { IsNested = true, NestedFunction = CreateEmptyResourceIdExpression() }]
            : string.Equals(fn.Name, "resourceId", StringComparison.OrdinalIgnoreCase)
                ? [new ArgEditorState(), new ArgEditorState()]
                : [];
        EnsureMinArgs();
        NormalizeArgsForSelectedFunction();
        RefreshPreviewMetadata();
        _previewResult = null;
    }

    private void OnArgChanged(int idx, string value)
    {
        if (idx < _args.Count)
        {
            _args[idx].LiteralInput = value;

            if (idx == 0 && _args.Count > 1 && IsResourceReferenceFunction(_selectedFunction?.Name))
            {
                _args[1].LiteralInput = string.Empty;
            }

            RefreshPreviewMetadata();
            _previewResult = null;
        }
    }

    private void AddArg()
    {
        var maxArgs = GetEffectiveMaxArgs();
        if (maxArgs is not null && _args.Count >= maxArgs)
        {
            return;
        }

        _args.Add(new ArgEditorState());
        NormalizeArgsForSelectedFunction();
        RefreshPreviewMetadata();
        _previewResult = null;
    }

    private void RemoveArgAt(int idx)
    {
        if (idx < 0 || idx >= _args.Count)
        {
            return;
        }

        _args.RemoveAt(idx);
        NormalizeArgsForSelectedFunction();
        RefreshPreviewMetadata();
        _previewResult = null;
    }

    private void ChangeArgKind(int idx, string kind)
    {
        if (idx < 0 || idx >= _args.Count)
        {
            return;
        }

        if (IsArgKindLockedToNested(idx))
        {
            kind = NestedArgKind;
        }

        var editor = _args[idx];
        editor.IsNested = string.Equals(kind, NestedArgKind, StringComparison.Ordinal);
        if (editor.IsNested)
        {
            editor.LiteralInput = string.Empty;
        }
        else
        {
            editor.NestedFunction = null;
        }

        NormalizeArgsForSelectedFunction();

        RefreshPreviewMetadata();
        _previewResult = null;
    }

    private async Task ConfigureNestedFunction(int idx)
    {
        if (idx < 0 || idx >= _args.Count)
        {
            return;
        }

        var parameters = new DialogParameters<DscFunctionPickerDialog>
        {
            { x => x.ParameterNames, ParameterNames },
            { x => x.VariableNames, VariableNames },
            { x => x.AvailableTypes, AvailableTypes },
            { x => x.ResourceReferences, ResourceReferences },
            { x => x.ExistingExpression, _args[idx].NestedFunction }
        };

        var dialog = await DialogService.ShowAsync<DscFunctionPickerDialog>(
            "Build Nested Function",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

        var result = await dialog.Result;
        if (result?.Data is DscFunctionExpression nested)
        {
            _args[idx].IsNested = true;
            _args[idx].NestedFunction = nested;
            _args[idx].LiteralInput = string.Empty;
            RefreshPreviewMetadata();
            _previewResult = null;
        }
    }

    private void ClearNestedFunction(int idx)
    {
        if (idx < 0 || idx >= _args.Count)
        {
            return;
        }

        _args[idx].NestedFunction = null;
        RefreshPreviewMetadata();
        _previewResult = null;
    }

    private void AddMockEnvVar() => _mockEnvVars[$"VAR_{_mockEnvVars.Count + 1}"] = string.Empty;
    private void AddMockParam() => _mockParams[$"param{_mockParams.Count + 1}"] = "\"value\"";

    private void RenameMockEnvVar(string oldName, string newName)
    {
        if (string.IsNullOrWhiteSpace(newName) || string.Equals(oldName, newName, StringComparison.Ordinal) || _mockEnvVars.ContainsKey(newName))
        {
            return;
        }

        var value = _mockEnvVars[oldName];
        _mockEnvVars.Remove(oldName);
        _mockEnvVars[newName] = value;
    }

    private void RenameMockParam(string oldName, string newName)
    {
        if (string.IsNullOrWhiteSpace(newName) || string.Equals(oldName, newName, StringComparison.Ordinal) || _mockParams.ContainsKey(newName))
        {
            return;
        }

        var value = _mockParams[oldName];
        _mockParams.Remove(oldName);
        _mockParams[newName] = value;
    }

    private bool TryGetLiteralOptions(int idx, out IReadOnlyList<string> options, out string placeholder)
    {
        options = [];
        placeholder = "value, 'string-literal', true, false, or null";

        if (_selectedFunction is null)
        {
            return false;
        }

        var functionName = _selectedFunction.Name;
        if (string.Equals(functionName, "parameters", StringComparison.OrdinalIgnoreCase) && idx == 0)
        {
            options = _usage?.Parameters.OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList() ?? [];
            placeholder = "Select a parameter";
            return true;
        }

        if (string.Equals(functionName, "variables", StringComparison.OrdinalIgnoreCase) && idx == 0)
        {
            options = _usage?.Variables.OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList() ?? [];
            placeholder = "Select a variable";
            return true;
        }

        if (string.Equals(functionName, "resourceId", StringComparison.OrdinalIgnoreCase) && idx == 0)
        {
            options = ResourceReferences
                .Select(r => r.Type)
                .Where(t => !string.IsNullOrWhiteSpace(t))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)
                .ToList();
            placeholder = "Select a resource type";
            return true;
        }

        if (string.Equals(functionName, "resourceId", StringComparison.OrdinalIgnoreCase) && idx == 1)
        {
            var typeName = _args.Count > 0 ? NormalizeLiteralToken(_args[0].LiteralInput) : string.Empty;
            var references = string.IsNullOrWhiteSpace(typeName)
                ? []
                : ResourceReferences.Where(r => string.Equals(r.Type, typeName, StringComparison.OrdinalIgnoreCase)).ToList();

            options = references.Select(r => r.Name).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            placeholder = string.IsNullOrWhiteSpace(typeName)
                ? "Select a resource type first"
                : "Select an instance name";
            return true;
        }

        return false;
    }

    private Task<IEnumerable<string>> SearchLiteralOptions(int idx, string? searchText)
    {
        if (!TryGetLiteralOptions(idx, out var options, out _))
        {
            return Task.FromResult(Enumerable.Empty<string>());
        }

        IEnumerable<string> filtered = options;
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            filtered = filtered.Where(option => option.Contains(searchText, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(filtered);
    }

    private string GetArgumentLabel(int idx)
    {
        if (_selectedFunction is null)
        {
            return $"Arg {idx + 1}";
        }

        if (string.Equals(_selectedFunction.Name, "reference", StringComparison.OrdinalIgnoreCase))
        {
            return "Resource";
        }

        if (string.Equals(_selectedFunction.Name, "resourceId", StringComparison.OrdinalIgnoreCase))
        {
            return idx == 0 ? "Resource type" : "Instance name";
        }

        return $"Arg {idx + 1}";
    }

    private static string GetLiteralPlaceholder() => "value, 'string-literal', true, false, or null";

    private static bool IsResourceReferenceFunction(string? functionName)
    {
        if (string.IsNullOrWhiteSpace(functionName))
        {
            return false;
        }

        return string.Equals(functionName, "reference", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(functionName, "resourceId", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsArgKindLockedToNested(int idx)
    {
        return _selectedFunction is not null &&
               string.Equals(_selectedFunction.Name, "reference", StringComparison.OrdinalIgnoreCase) &&
               idx == 0;
    }

    private int GetEffectiveMinArgs()
    {
        if (_selectedFunction is null)
        {
            return 0;
        }

        if (string.Equals(_selectedFunction.Name, "resourceId", StringComparison.OrdinalIgnoreCase))
        {
            return 2;
        }

        if (string.Equals(_selectedFunction.Name, "reference", StringComparison.OrdinalIgnoreCase))
        {
            return 1;
        }

        return _selectedFunction.MinArgs ?? 0;
    }

    private int? GetEffectiveMaxArgs()
    {
        if (_selectedFunction is null)
        {
            return null;
        }

        if (string.Equals(_selectedFunction.Name, "resourceId", StringComparison.OrdinalIgnoreCase))
        {
            return 2;
        }

        if (string.Equals(_selectedFunction.Name, "reference", StringComparison.OrdinalIgnoreCase))
        {
            return 1;
        }

        return _selectedFunction.MaxArgs;
    }

    private void NormalizeArgsForSelectedFunction()
    {
        if (_selectedFunction is null)
        {
            return;
        }

        if (string.Equals(_selectedFunction.Name, "reference", StringComparison.OrdinalIgnoreCase))
        {
            if (_args.Count == 0)
            {
                _args.Add(new ArgEditorState());
            }

            _args[0].IsNested = true;
            _args[0].NestedFunction ??= CreateEmptyResourceIdExpression();
            _args[0].LiteralInput = string.Empty;

            if (_args.Count > 1)
            {
                _args.RemoveRange(1, _args.Count - 1);
            }

            return;
        }

        if (string.Equals(_selectedFunction.Name, "resourceId", StringComparison.OrdinalIgnoreCase))
        {
            while (_args.Count < 2)
            {
                _args.Add(new ArgEditorState());
            }

            if (_args.Count > 2)
            {
                _args.RemoveRange(2, _args.Count - 2);
            }

            for (var i = 0; i < 2; i++)
            {
                _args[i].IsNested = false;
                _args[i].NestedFunction = null;
            }
        }
    }

    private static string NormalizeLiteralToken(string input)
    {
        var token = input.Trim();
        if (token.Length >= 2)
        {
            if ((token.StartsWith('"') && token.EndsWith('"')) ||
                (token.StartsWith('\'') && token.EndsWith('\'')))
            {
                token = token[1..^1];
            }
        }

        return token;
    }

    private async Task RunPreview()
    {
        var expression = BuildExpression();
        if (expression is null)
        {
            _previewResult = null;
            return;
        }

        _previewResult = await FunctionService.EvaluateExpressionAsync(expression.ToInlineString());
    }

    private void Cancel() => MudDialog.Cancel();

    private void Insert()
    {
        var expr = BuildExpression();
        if (expr is null) return;

        MudDialog.Close(DialogResult.Ok(expr));
    }

    private DscFunctionExpression? BuildExpression()
    {
        if (_selectedFunction is null)
        {
            return null;
        }

        var args = _args.Select(ToFunctionArg).ToList();
        return new DscFunctionExpression
        {
            FunctionName = _selectedFunction.Name,
            Args = args
        };
    }

    private static FunctionArg ToFunctionArg(ArgEditorState arg)
    {
        if (arg.IsNested && arg.NestedFunction is not null)
        {
            return FunctionArg.Nested(arg.NestedFunction);
        }

        return ParseLiteralArgument(arg.LiteralInput);
    }

    private static string FormatLiteralInput(object? value) => value switch
    {
        null => string.Empty,
        string s => s,
        bool b => b ? "true" : "false",
        _ => value.ToString() ?? string.Empty
    };

    private static FunctionArg ParseLiteralArgument(string input)
    {
        var trimmed = input.Trim();

        if (long.TryParse(trimmed, out var l)) return FunctionArg.Literal(l);
        if (trimmed.Equals("true", StringComparison.OrdinalIgnoreCase)) return FunctionArg.Literal(true);
        if (trimmed.Equals("false", StringComparison.OrdinalIgnoreCase)) return FunctionArg.Literal(false);
        if (trimmed.Equals("null", StringComparison.OrdinalIgnoreCase)) return FunctionArg.Literal(null);

        if (trimmed.StartsWith('\'') && trimmed.EndsWith('\'') && trimmed.Length >= 2)
        {
            return FunctionArg.Literal(trimmed[1..^1]);
        }

        return FunctionArg.Literal(trimmed);
    }

    private string GetMockEnvVar(string name) =>
        _mockEnvVars.TryGetValue(name, out var value) ? value : string.Empty;

    private void SetMockEnvVar(string name, string value) => _mockEnvVars[name] = value;

    private string GetMockParameter(string name) =>
        _mockParams.TryGetValue(name, out var value) ? value : string.Empty;

    private void SetMockParameter(string name, string value) => _mockParams[name] = value;

    private string GetMockVariable(string name) =>
        _mockVariables.TryGetValue(name, out var value) ? value : string.Empty;

    private void SetMockVariable(string name, string value) => _mockVariables[name] = value;

    private string GetMockReferenceOutput(string key) =>
        _mockReferenceOutputs.TryGetValue(key, out var value) ? value : "{}";

    private void SetMockReferenceOutput(string key, string value) =>
        _mockReferenceOutputs[key] = string.IsNullOrWhiteSpace(value) ? "{}" : value;

    private static DscFunctionExpression CreateEmptyResourceIdExpression() => new()
    {
        FunctionName = "resourceId",
        Args = [FunctionArg.Literal(string.Empty), FunctionArg.Literal(string.Empty)]
    };

    private FunctionPreviewUsage? BuildUsage()
    {
        var expression = BuildExpression();
        if (expression is null)
        {
            return null;
        }

        var usage = new FunctionPreviewUsage();
        CollectUsage(expression, usage);
        return usage;
    }

    private void RefreshPreviewMetadata()
    {
        _usage = BuildUsage();
        _referenceTargets = BuildReferenceTargets(_usage).ToList();
    }

    private static void CollectUsage(DscFunctionExpression expression, FunctionPreviewUsage usage)
    {
        foreach (var arg in expression.Args)
        {
            if (arg.IsNested && arg.NestedFunction is not null)
            {
                CollectUsage(arg.NestedFunction, usage);
            }
        }

        if (string.Equals(expression.FunctionName, "envvar", StringComparison.OrdinalIgnoreCase) &&
            expression.Args.Count > 0 && expression.Args[0].LiteralValue is string envName && !string.IsNullOrWhiteSpace(envName))
        {
            usage.EnvVars.Add(envName);
        }

        if (string.Equals(expression.FunctionName, "parameters", StringComparison.OrdinalIgnoreCase) &&
            expression.Args.Count > 0 && expression.Args[0].LiteralValue is string parameterName && !string.IsNullOrWhiteSpace(parameterName))
        {
            usage.Parameters.Add(parameterName);
        }

        if (string.Equals(expression.FunctionName, "variables", StringComparison.OrdinalIgnoreCase) &&
            expression.Args.Count > 0 && expression.Args[0].LiteralValue is string variableName && !string.IsNullOrWhiteSpace(variableName))
        {
            usage.Variables.Add(variableName);
        }

        if (string.Equals(expression.FunctionName, "reference", StringComparison.OrdinalIgnoreCase))
        {
            var targetKey = ResolveReferenceTargetKey(expression);
            if (!string.IsNullOrWhiteSpace(targetKey))
            {
                usage.ReferenceTargets.Add(targetKey);
            }
        }
    }

    private static IEnumerable<ReferenceTarget> BuildReferenceTargets(FunctionPreviewUsage? usage)
    {
        if (usage is null)
        {
            return [];
        }

        return usage.ReferenceTargets
            .OrderBy(key => key, StringComparer.OrdinalIgnoreCase)
            .Select(key => new ReferenceTarget(key, key));
    }

    private FunctionPreviewNode? BuildCompositionTree()
    {
        var expression = BuildExpression();
        if (expression is null)
        {
            return null;
        }

        return BuildCompositionNode(expression, "root");
    }

    private FunctionPreviewNode BuildCompositionNode(DscFunctionExpression expression, string path)
    {
        var node = new FunctionPreviewNode
        {
            Key = path,
            Title = expression.FunctionName,
            IsFunction = true
        };

        for (var i = 0; i < expression.Args.Count; i++)
        {
            var arg = expression.Args[i];
            var childPath = $"{path}.{i}";
            if (arg.IsNested && arg.NestedFunction is not null)
            {
                var childNode = BuildCompositionNode(arg.NestedFunction, childPath);
                childNode.Title = $"arg {i + 1}: {arg.NestedFunction.FunctionName}";
                node.Children.Add(childNode);
            }
            else
            {
                var literalValue = arg.LiteralValue;
                node.Children.Add(new FunctionPreviewNode
                {
                    Key = childPath,
                    Title = $"arg {i + 1}: {FormatLeafValue(literalValue)}",
                    IsFunction = false
                });
            }
        }

        return node;
    }

    private static string ResolveReferenceTargetKey(DscFunctionExpression expression)
    {
        if (!string.Equals(expression.FunctionName, "reference", StringComparison.OrdinalIgnoreCase) || expression.Args.Count == 0)
        {
            return string.Empty;
        }

        var firstArg = expression.Args[0];
        if (firstArg.IsNested && firstArg.NestedFunction is not null)
        {
            return firstArg.NestedFunction.ToInlineString();
        }

        return firstArg.LiteralValue?.ToString() ?? string.Empty;
    }

    private string ResolveReferenceTargetKey()
    {
        if (_selectedFunction is null)
        {
            return string.Empty;
        }

        var expression = BuildExpression();
        return expression is null ? string.Empty : ResolveReferenceTargetKey(expression);
    }

    private static string FormatLeafValue(object? value)
    {
        return value switch
        {
            null => "null",
            string s => s,
            bool b => b ? "true" : "false",
            JsonNode node => node.ToJsonString(),
            JsonElement element => element.GetRawText(),
            _ => value.ToString() ?? string.Empty
        };
    }

    private RenderFragment RenderCompositionNode(FunctionPreviewNode node, int depth) => builder =>
    {
        var seq = 0;
        var hasChildren = node.Children.Count > 0;
        var indentPx = depth * 20;

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style", "display: flex; align-items: flex-start; gap: 8px; padding: 2px 0;");

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style", $"width: {indentPx}px; flex-shrink: 0;");
        builder.CloseElement();

        if (hasChildren)
        {
            builder.OpenComponent<MudIconButton>(seq++);
            builder.AddAttribute(seq++, "Icon", node.IsExpanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight);
            builder.AddAttribute(seq++, "Size", Size.Small);
            builder.AddAttribute(seq++, "OnClick", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, _ => node.IsExpanded = !node.IsExpanded));
            builder.CloseComponent();
        }
        else
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "style", "width: 32px; display: inline-block;");
            builder.CloseElement();
        }

        builder.OpenComponent<MudIcon>(seq++);
        builder.AddAttribute(seq++, "Icon", node.IsFunction ? Icons.Material.Filled.Functions : Icons.Material.Filled.Label);
        builder.AddAttribute(seq++, "Size", Size.Small);
        builder.AddAttribute(seq++, "Color", node.IsFunction ? Color.Primary : Color.Default);
        builder.CloseComponent();

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "style", "font-family: monospace; line-height: 1.6;");
        builder.AddContent(seq++, node.Title);
        builder.CloseElement();

        builder.CloseElement();

        if (hasChildren && node.IsExpanded)
        {
            foreach (var child in node.Children)
            {
                builder.AddContent(seq++, RenderCompositionNode(child, depth + 1));
            }
        }
    };

    private sealed class FunctionPreviewUsage
    {
        public HashSet<string> EnvVars { get; } = new(StringComparer.Ordinal);
        public HashSet<string> Parameters { get; } = new(StringComparer.Ordinal);
        public HashSet<string> Variables { get; } = new(StringComparer.Ordinal);
        public HashSet<string> ReferenceTargets { get; } = new(StringComparer.Ordinal);
    }

    private sealed class FunctionPreviewNode
    {
        public string Key { get; init; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public bool IsFunction { get; init; }
        public bool IsExpanded { get; set; } = true;
        public object? ResolvedValue { get; set; }
        public string? ResultText { get; set; }
        public List<FunctionPreviewNode> Children { get; } = [];
    }

    private sealed record ReferenceTarget(string Key, string DisplayLabel);

    private void EnsureMinArgs()
    {
        if (_selectedFunction is null)
        {
            return;
        }

        var minArgs = GetEffectiveMinArgs();
        while (_args.Count < minArgs)
        {
            _args.Add(new ArgEditorState());
        }

        var maxArgs = GetEffectiveMaxArgs();
        if (maxArgs is not null && _args.Count > maxArgs)
        {
            _args.RemoveRange(maxArgs.Value, _args.Count - maxArgs.Value);
        }
    }

    private static int CountNestedFunctions(DscFunctionExpression expression)
    {
        return expression.Args
            .Where(a => a.IsNested && a.NestedFunction is not null)
            .Sum(a => 1 + CountNestedFunctions(a.NestedFunction!));
    }

    private sealed class ArgEditorState
    {
        public bool IsNested { get; set; }
        public string LiteralInput { get; set; } = string.Empty;
        public DscFunctionExpression? NestedFunction { get; set; }
    }

    private sealed class FunctionTreeItem
    {
        public string Label { get; init; } = string.Empty;
        public bool IsFunction { get; init; }
    }

    private List<TreeItemData<FunctionTreeItem>> BuildFunctionTreeItems()
    {
        if (_selectedFunction is null)
        {
            return [];
        }

        var rootChildren = BuildArgTreeItems(_args);
        return [new TreeItemData<FunctionTreeItem>
        {
            Value = new FunctionTreeItem { Label = $"{_selectedFunction.Name}()", IsFunction = true },
            Children = rootChildren
        }];
    }

    private static List<TreeItemData<FunctionTreeItem>> BuildArgTreeItems(List<ArgEditorState> args)
    {
        var items = new List<TreeItemData<FunctionTreeItem>>();
        for (var i = 0; i < args.Count; i++)
        {
            var arg = args[i];
            if (arg.IsNested && arg.NestedFunction is not null)
            {
                var children = BuildExpressionArgTreeItems(arg.NestedFunction.Args);
                items.Add(new TreeItemData<FunctionTreeItem>
                {
                    Value = new FunctionTreeItem { Label = $"arg {i + 1}: {arg.NestedFunction.FunctionName}()", IsFunction = true },
                    Children = children
                });
            }
            else
            {
                var displayValue = string.IsNullOrWhiteSpace(arg.LiteralInput) ? "(not set)" : arg.LiteralInput;
                items.Add(new TreeItemData<FunctionTreeItem>
                {
                    Value = new FunctionTreeItem { Label = $"arg {i + 1}: {displayValue}", IsFunction = false },
                    Children = []
                });
            }
        }

        return items;
    }

    private static List<TreeItemData<FunctionTreeItem>> BuildExpressionArgTreeItems(List<FunctionArg> args)
    {
        var items = new List<TreeItemData<FunctionTreeItem>>();
        for (var i = 0; i < args.Count; i++)
        {
            var arg = args[i];
            if (arg.IsNested && arg.NestedFunction is not null)
            {
                var children = BuildExpressionArgTreeItems(arg.NestedFunction.Args);
                items.Add(new TreeItemData<FunctionTreeItem>
                {
                    Value = new FunctionTreeItem { Label = $"arg {i + 1}: {arg.NestedFunction.FunctionName}()", IsFunction = true },
                    Children = children
                });
            }
            else
            {
                var displayValue = arg.LiteralValue switch
                {
                    null => "null",
                    string s => $"'{s}'",
                    bool b => b ? "true" : "false",
                    _ => arg.LiteralValue.ToString()!
                };
                items.Add(new TreeItemData<FunctionTreeItem>
                {
                    Value = new FunctionTreeItem { Label = $"arg {i + 1}: {displayValue}", IsFunction = false },
                    Children = []
                });
            }
        }

        return items;
    }
}


