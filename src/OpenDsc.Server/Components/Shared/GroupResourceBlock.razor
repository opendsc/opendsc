@rendermode InteractiveServer

@using OpenDsc.Server.Services

@inject IDialogService DialogService

<MudCard Outlined="true" Class="mb-3" Style="border-left: 4px solid var(--mud-palette-primary);">
    <MudCardHeader>
        <CardHeaderContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
                @if (!ReadOnly && _isEditingName)
                {
                    <MudTextField T="string" Value="@Resource.Name"
                                  ValueChanged="@(v => { Resource.Name = v; ResourceChanged.InvokeAsync(Resource); })"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" OnBlur="@(() => _isEditingName = false)"
                                  Immediate="true" Style="width: 170px;" />
                }
                else
                {
                    <MudText Typo="Typo.subtitle1" Style="font-weight: bold;">@Resource.Name</MudText>
                    @if (!ReadOnly)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="ma-0"
                                       OnClick="@(() => _isEditingName = true)" />
                    }
                }
                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@Resource.Type</MudChip>
            </div>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@(_isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           Color="Color.Default" Size="Size.Small" OnClick="ToggleExpanded" />
            @if (!ReadOnly)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => OnRemove.InvokeAsync(Resource))" />
            }
        </CardHeaderActions>
    </MudCardHeader>

    @if (_isExpanded)
    {
        <MudCardContent>
            @if (Resource.Condition is not null)
            {
                <div class="d-flex align-start gap-2 mb-2">
                    <div class="flex-grow-1">
                        <ResourcePropertyField Label="Condition" Value="@Resource.Condition"
                                               Description="Optional runtime check. Must evaluate to true for the resource to run."
                                               ParameterNames="@ParameterNames" VariableNames="@VariableNames" AvailableTypes="@AvailableTypes"
                                               ResourceReferences="@ResourceReferences" ReadOnly="@ReadOnly" AllowFunctions="true"
                                               ValueChanged="OnConditionChanged" />
                        @if (!string.IsNullOrWhiteSpace(ConditionValidationError))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">@ConditionValidationError</MudText>
                        }
                    </div>
                    @if (!ReadOnly)
                    {
                        <MudTooltip Text="Remove condition">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                           Class="mt-1" OnClick="RemoveCondition" />
                        </MudTooltip>
                    }
                </div>
            }
            else if (!ReadOnly)
            {
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Rule" Variant="Variant.Text"
                           OnClick="AddCondition" Class="mb-2">
                    Add condition
                </MudButton>
            }

            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.subtitle2">Nested resources</MudText>
                @if (!ReadOnly)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Outlined"
                               OnClick="@(async () => await AddNestedResource())">
                        Add nested resource
                    </MudButton>
                }
            </div>

            @if (Resource.NestedResources.Count == 0)
            {
                <MudText Color="Color.Secondary" Typo="Typo.body2" Class="mb-2">
                    No nested resources. Add resource instances that belong to this group or assertion.
                </MudText>
            }

            <div style="padding-left: 16px; border-left: 2px solid var(--mud-palette-divider);">
                @foreach (var nested in Resource.NestedResources.ToList())
                {
                    var nr = nested;
                    @if (IsGroupOrAssertion(nr.Type))
                    {
                        <GroupResourceBlock Resource="@nr"
                                            ResourceChanged="@(r => { var i = Resource.NestedResources.IndexOf(nr); if (i >= 0) Resource.NestedResources[i] = r; ResourceChanged.InvokeAsync(Resource); })"
                                            OnRemove="@(r => { Resource.NestedResources.Remove(r); ResourceChanged.InvokeAsync(Resource); })"
                                            ParameterNames="@ParameterNames" VariableNames="@VariableNames" ReadOnly="@ReadOnly"
                                            AvailableTypes="@AvailableTypes" ResourceReferences="@ResourceReferences"
                                            CollapseCommandVersion="@CollapseCommandVersion" ExpandOnCommand="@ExpandOnCommand" />
                    }
                    else
                    {
                        <ResourceInstanceBlock Resource="@nr"
                                               ResourceChanged="@(r => { var i = Resource.NestedResources.IndexOf(nr); if (i >= 0) Resource.NestedResources[i] = r; ResourceChanged.InvokeAsync(Resource); })"
                                               OnRemove="@(r => { Resource.NestedResources.Remove(r); ResourceChanged.InvokeAsync(Resource); })"
                                               ParameterNames="@ParameterNames" VariableNames="@VariableNames" ReadOnly="@ReadOnly"
                                               AvailableTypes="@AvailableTypes" ResourceReferences="@ResourceReferences"
                                               CollapseCommandVersion="@CollapseCommandVersion" ExpandOnCommand="@ExpandOnCommand" />
                    }
                }
            </div>
        </MudCardContent>
    }
</MudCard>

@code {
    [Parameter, EditorRequired]
    public ConfigResourceState Resource { get; set; } = default!;

    [Parameter]
    public EventCallback<ConfigResourceState> ResourceChanged { get; set; }

    [Parameter]
    public EventCallback<ConfigResourceState> OnRemove { get; set; }

    [Parameter]
    public IReadOnlyList<string> ParameterNames { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> VariableNames { get; set; } = [];

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public IReadOnlyList<string> AvailableTypes { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ResourceReferenceOption> ResourceReferences { get; set; } = [];

    [Parameter]
    public int CollapseCommandVersion { get; set; }

    [Parameter]
    public bool ExpandOnCommand { get; set; } = true;

    private bool _isEditingName;
    private bool _isExpanded = true;
    private int _lastCollapseCommandVersion = -1;
    private string? ConditionValidationError => ValidateCondition(Resource.Condition);

    protected override void OnParametersSet()
    {
        if (_lastCollapseCommandVersion != CollapseCommandVersion)
        {
            _lastCollapseCommandVersion = CollapseCommandVersion;
            _isExpanded = ExpandOnCommand;
        }
    }

    private static bool IsGroupOrAssertion(string type) =>
        type.Equals("Microsoft.DSC/Group", StringComparison.OrdinalIgnoreCase) ||
        type.Equals("Microsoft.DSC/Assertion", StringComparison.OrdinalIgnoreCase);

    private async Task AddNestedResource()
    {
        if (ReadOnly)
        {
            return;
        }

        var dialog = await DialogService.ShowAsync<AddResourceDialog>(
            "Add Nested Resource",
            new DialogParameters<AddResourceDialog>
            {
                { x => x.DefaultName, $"nestedResource{Resource.NestedResources.Count + 1}" }
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result?.Data is not (string type, string name) || string.IsNullOrWhiteSpace(type))
        {
            return;
        }

        Resource.NestedResources.Add(new ConfigResourceState
        {
            Name = string.IsNullOrWhiteSpace(name) ? $"nestedResource{Resource.NestedResources.Count + 1}" : name,
            Type = type
        });
        await ResourceChanged.InvokeAsync(Resource);
    }

    private void ToggleExpanded()
    {
        _isExpanded = !_isExpanded;
    }

    private void AddCondition()
    {
        if (ReadOnly)
        {
            return;
        }

        Resource.Condition = ConfigPropertyValue.Literal(string.Empty);
        ResourceChanged.InvokeAsync(Resource);
    }

    private void RemoveCondition()
    {
        if (ReadOnly)
        {
            return;
        }

        Resource.Condition = null;
        ResourceChanged.InvokeAsync(Resource);
    }

    private void OnConditionChanged(ConfigPropertyValue value)
    {
        Resource.Condition = value;
        ResourceChanged.InvokeAsync(Resource);
    }

    private static string? ValidateCondition(ConfigPropertyValue? condition)
    {
        if (condition is null || condition.IsFunction)
        {
            return null;
        }

        if (condition.RawValue is not string text)
        {
            return "Condition should be a function expression string that evaluates to boolean.";
        }

        if (string.IsNullOrWhiteSpace(text))
        {
            return "Condition is empty. Use a function expression like [equals(...)] or remove it.";
        }

        return null;
    }
}

