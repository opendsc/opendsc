@rendermode InteractiveServer

@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Text.RegularExpressions

@inject IDialogService DialogService

<div class="@($"d-flex align-center gap-2 {ContainerClass}")">
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <MudTooltip Text="@Description">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" />
        </MudTooltip>
    }

    @if (Value.IsFunction && Value.Function is not null)
    {
        var _nestedCount = CountNestedFunctions(Value.Function);
        <MudField Label="@Label" Variant="Variant.Outlined" Style="min-width: 200px; flex: 1;">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Functions" Size="Size.Small" Color="Color.Primary" />
                <div>
                    <MudText Typo="Typo.body2" Style="font-family: monospace; line-height: 1.2;">
                        @Value.Function.FunctionName</MudText>
                        @if (_nestedCount > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 1.2;">@_nestedCount nested
                                function@(_nestedCount == 1 ? "" : "s")</MudText>
                            }
                        </div>
                    </div>
                </MudField>
                <MudTooltip Text="Mock function preview">
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" OnClick="OpenFunctionPreview" />
                </MudTooltip>
                <MudTooltip Text="Edit function">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="OpenFunctionPicker" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="ClearFunction" />
            }
    else
            {
                var variantChoices = GetOneOfVariantChoices();
                @switch (EffectiveType)
                {
                    case "boolean":
                        <MudCheckBox T="bool" Label="@Label" Value="@(Value.RawValue is true)" ValueChanged="@OnBoolChanged"
                                     Disabled="@ReadOnly" />
                        break;

                    case "integer":
                    case "number":
                        var numError = ValidateConstraints(Value.RawValue);
                        <MudNumericField T="long" Label="@Label" Variant="Variant.Outlined" Disabled="@ReadOnly"
                                         Value="@(Value.RawValue is long l ? l : 0)" ValueChanged="@(v => OnValueChanged(v))"
                                         Error="@(numError is not null)" ErrorText="@numError" />
                        break;

                    case "object":
                    case "array":
                        <ComplexValueEditor Label="@Label" Value="@Value.RawValue" RootKind="@EffectiveType" ReadOnly="@ReadOnly"
                                            ValueChanged="OnValueChanged" />
                        break;

                    default:
                        @if (variantChoices.Count > 0)
                        {
                            <MudSelect T="string" Label="@Label" Variant="Variant.Outlined" Disabled="@ReadOnly"
                                       Value="@GetCurrentVariantChoice(variantChoices)" ValueChanged="@(choice => OnVariantChoiceChanged(choice))">
                                @foreach (var choice in variantChoices)
                                {
                                    <MudSelectItem T="string" Value="@choice">@choice</MudSelectItem>
                                }
                            </MudSelect>
                        }

                        @if (AllowedValues.Count > 0)
                        {
                            <MudSelect T="string" Label="@Label" Variant="Variant.Outlined" Disabled="@ReadOnly"
                                       Value="@(Value.RawValue?.ToString() ?? string.Empty)" ValueChanged="@(v => OnValueChanged(v))">
                                @foreach (var option in AllowedValues)
                                {
                                    <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            var strError = ValidateConstraints(Value.RawValue?.ToString());
                            <MudTextField T="string" Label="@Label" Variant="Variant.Outlined" Disabled="@ReadOnly"
                                          Value="@(Value.RawValue?.ToString() ?? string.Empty)" ValueChanged="@(v => OnValueChanged(v))" Immediate="true"
                                          Error="@(strError is not null)" ErrorText="@strError" />
                        }
                        break;
                }

                @if (!ReadOnly && !Value.IsFunction && SupportsNullLiteral)
                {
                    <MudTooltip Text="Set value to null">
                        <MudIconButton Icon="@Icons.Material.Filled.DoNotDisturb" Size="Size.Small" OnClick="SetNullLiteral"
                                       Disabled="@(Value.RawValue is null)" />
                    </MudTooltip>
                }

                @if (AllowFunctions && !ReadOnly)
                {
                    <MudTooltip Text="Use a DSC function expression">
                        <MudIconButton Icon="@Icons.Material.Filled.Functions" Size="Size.Small" OnClick="OpenFunctionPicker" />
                    </MudTooltip>
                }

            }
        </div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public ConfigPropertyValue Value { get; set; } = new();

    [Parameter]
    public EventCallback<ConfigPropertyValue> ValueChanged { get; set; }

    /// <summary>JSON Schema node for this property (optional). Used to derive type and enum values.</summary>
    [Parameter]
    public JsonElement? Schema { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public IReadOnlyList<string> ParameterNames { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> VariableNames { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> AvailableTypes { get; set; } = [];

    [Parameter]
    public IReadOnlyList<ResourceReferenceOption> ResourceReferences { get; set; } = [];

    [Parameter]
    public string? RootSchemaJson { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool AllowFunctions { get; set; } = true;

    [Parameter]
    public string ContainerClass { get; set; } = "mb-2";

    private string EffectiveType
    {
        get
        {
            if (!Value.IsFunction && TryInferTypeFromValue(Value.RawValue, out var valueType))
            {
                return valueType;
            }

            return TryGetEffectiveType(Schema, out var schemaType) ? schemaType : "string";
        }
    }

    private bool IsComplexType => EffectiveType is "object" or "array";

    private bool SupportsNullLiteral => SchemaAllowsNull(Schema);

    private static bool TryInferTypeFromValue(object? value, out string type)
    {
        type = "string";
        if (value is null)
        {
            return false;
        }

        if (value is JsonObject or IDictionary<string, object?>)
        {
            type = "object";
            return true;
        }

        if (value is JsonArray or IEnumerable<object?>)
        {
            type = "array";
            return true;
        }

        if (value is bool)
        {
            type = "boolean";
            return true;
        }

        if (value is sbyte or byte or short or ushort or int or uint or long or ulong or float or double or decimal)
        {
            type = "number";
            return true;
        }

        if (value is string)
        {
            type = "string";
            return true;
        }

        return false;
    }

    private static bool TryGetEffectiveType(JsonElement? schema, out string type)
    {
        type = "string";
        if (!schema.HasValue)
        {
            return false;
        }

        if (TryGetTypeFromElement(schema.Value, out type))
        {
            return true;
        }

        if (schema.Value.TryGetProperty("anyOf", out var anyOf) && anyOf.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in anyOf.EnumerateArray())
            {
                if (TryGetTypeFromElement(item, out type))
                {
                    return true;
                }
            }
        }

        if (schema.Value.TryGetProperty("oneOf", out var oneOf) && oneOf.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in oneOf.EnumerateArray())
            {
                if (TryGetTypeFromElement(item, out type))
                {
                    return true;
                }
            }
        }

        return false;
    }

    private static bool TryGetTypeFromElement(JsonElement schemaElement, out string type)
    {
        type = "string";
        if (!schemaElement.TryGetProperty("type", out var typeProp))
        {
            return false;
        }

        if (typeProp.ValueKind == JsonValueKind.String)
        {
            var parsed = typeProp.GetString();
            if (!string.IsNullOrWhiteSpace(parsed) && !string.Equals(parsed, "null", StringComparison.OrdinalIgnoreCase))
            {
                type = parsed;
                return true;
            }

            return false;
        }

        if (typeProp.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in typeProp.EnumerateArray())
            {
                if (item.ValueKind != JsonValueKind.String)
                {
                    continue;
                }

                var parsed = item.GetString();
                if (!string.IsNullOrWhiteSpace(parsed) && !string.Equals(parsed, "null", StringComparison.OrdinalIgnoreCase))
                {
                    type = parsed;
                    return true;
                }
            }
        }

        return false;
    }

    private static bool SchemaAllowsNull(JsonElement? schema)
    {
        if (!schema.HasValue)
        {
            return false;
        }

        return ElementDeclaresNull(schema.Value);
    }

    private static bool ElementDeclaresNull(JsonElement element)
    {
        if (element.TryGetProperty("type", out var typeProp))
        {
            if (typeProp.ValueKind == JsonValueKind.String &&
                string.Equals(typeProp.GetString(), "null", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            if (typeProp.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in typeProp.EnumerateArray())
                {
                    if (item.ValueKind == JsonValueKind.String &&
                        string.Equals(item.GetString(), "null", StringComparison.OrdinalIgnoreCase))
                    {
                        return true;
                    }
                }
            }
        }

        if (element.TryGetProperty("const", out var constProp) && constProp.ValueKind == JsonValueKind.Null)
        {
            return true;
        }

        if (element.TryGetProperty("anyOf", out var anyOf) && anyOf.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in anyOf.EnumerateArray())
            {
                if (ElementDeclaresNull(item))
                {
                    return true;
                }
            }
        }

        if (element.TryGetProperty("oneOf", out var oneOf) && oneOf.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in oneOf.EnumerateArray())
            {
                if (ElementDeclaresNull(item))
                {
                    return true;
                }
            }
        }

        return false;
    }

    private List<string> AllowedValues
    {
        get
        {
            var list = new List<string>();
            if (Schema.HasValue && Schema.Value.TryGetProperty("enum", out var enumProp) &&
                enumProp.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in enumProp.EnumerateArray())
                {
                    list.Add(item.ToString());
                }
            }
            return list;
        }
    }

    private string? ValidateConstraints(object? value)
    {
        if (value is null || !Schema.HasValue)
        {
            return null;
        }

        var schema = Schema.Value;

        // String validation
        if (value is string strValue)
        {
            if (schema.TryGetProperty("minLength", out var minLen) && minLen.GetInt32() > strValue.Length)
            {
                return $"Minimum length is {minLen.GetInt32()}";
            }

            if (schema.TryGetProperty("maxLength", out var maxLen) && maxLen.GetInt32() < strValue.Length)
            {
                return $"Maximum length is {maxLen.GetInt32()}";
            }

            if (schema.TryGetProperty("pattern", out var pattern) && pattern.GetString() is { } regex)
            {
                try
                {
                    if (!Regex.IsMatch(strValue, regex))
                    {
                        return $"Value does not match required pattern";
                    }
                }
                catch (RegexParseException ex)
                {
                    return $"Invalid regex pattern: {ex.Message}";
                }
            }
        }

        // Numeric validation
        if (value is long longValue)
        {
            if (schema.TryGetProperty("minimum", out var min) && min.GetInt64() > longValue)
            {
                return $"Minimum value is {min.GetInt64()}";
            }

            if (schema.TryGetProperty("maximum", out var max) && max.GetInt64() < longValue)
            {
                return $"Maximum value is {max.GetInt64()}";
            }
        }

        return null;
    }

    private async Task OnBoolChanged(bool newValue)
    {
        await ValueChanged.InvokeAsync(ConfigPropertyValue.Literal(newValue));
    }

    private async Task OnValueChanged(object? newValue)
    {
        await ValueChanged.InvokeAsync(ConfigPropertyValue.Literal(newValue));
    }

    private async Task ClearFunction()
    {
        await ValueChanged.InvokeAsync(ConfigPropertyValue.Literal(null));
    }

    private async Task SetNullLiteral()
    {
        await ValueChanged.InvokeAsync(ConfigPropertyValue.Literal(null));
    }

    private async Task OpenFunctionPicker()
    {
        var parameters = new DialogParameters<DscFunctionPickerDialog>
        {
            { x => x.ParameterNames, ParameterNames },
            { x => x.VariableNames, VariableNames },
            { x => x.AvailableTypes, AvailableTypes },
            { x => x.ResourceReferences, ResourceReferences },
            { x => x.ExistingExpression, Value.IsFunction ? Value.Function : null }
        };

        var dialog = await DialogService.ShowAsync<DscFunctionPickerDialog>(
            "Insert DSC Function", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

        var result = await dialog.Result;
        if (result?.Data is DscFunctionExpression expr)
        {
            await ValueChanged.InvokeAsync(ConfigPropertyValue.FromFunction(expr));
        }
    }

    private async Task OpenFunctionPreview()
    {
        if (!Value.IsFunction || Value.Function is null)
        {
            return;
        }

        var parameters = new DialogParameters<DscFunctionPickerDialog>
        {
            { x => x.ParameterNames, ParameterNames },
            { x => x.VariableNames, VariableNames },
            { x => x.AvailableTypes, AvailableTypes },
            { x => x.ResourceReferences, ResourceReferences },
            { x => x.ExistingExpression, Value.Function },
            { x => x.PreviewOnly, true }
        };

        await DialogService.ShowAsync<DscFunctionPickerDialog>(
            "Mock Function Preview", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    private List<string> GetOneOfVariantChoices()
    {
        var resolvedSchema = ResolveSchema(Schema);
        if (resolvedSchema is null)
        {
            return [];
        }

        var branches = GetOneOfBranches(resolvedSchema.Value);
        if (branches.Length == 0)
        {
            return [];
        }

        var variants = new List<string>();
        foreach (var branch in branches)
        {
            if (ElementDeclaresNull(branch))
            {
                continue;
            }

            if (branch.TryGetProperty("enum", out var enumProp) && enumProp.ValueKind == JsonValueKind.Array)
            {
                var items = enumProp.EnumerateArray()
                    .Where(e => e.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(e.GetString()))
                    .ToList();
                if (items.Count == 1)
                {
                    variants.Add(items[0].GetString()!);
                    continue;
                }
            }

            if (branch.TryGetProperty("properties", out var props) && props.ValueKind == JsonValueKind.Object)
            {
                var propList = props.EnumerateObject().ToList();
                if (propList.Count == 1)
                {
                    variants.Add(propList[0].Name);
                    continue;
                }
            }

            return [];
        }

        return variants;
    }

    private string GetCurrentVariantChoice(IReadOnlyList<string> choices)
    {
        if (Value.RawValue is string rawString && choices.Contains(rawString, StringComparer.OrdinalIgnoreCase))
        {
            return choices.First(c => string.Equals(c, rawString, StringComparison.OrdinalIgnoreCase));
        }

        if (Value.RawValue is IDictionary<string, object?> map && map.Count == 1)
        {
            var key = map.Keys.First();
            if (choices.Contains(key, StringComparer.OrdinalIgnoreCase))
            {
                return choices.First(c => string.Equals(c, key, StringComparison.OrdinalIgnoreCase));
            }
        }

        return choices.FirstOrDefault() ?? string.Empty;
    }

    private async Task OnVariantChoiceChanged(string choice)
    {
        if (string.IsNullOrWhiteSpace(choice))
        {
            return;
        }

        var resolvedSchema = ResolveSchema(Schema);
        if (resolvedSchema is null)
        {
            return;
        }

        foreach (var branch in GetOneOfBranches(resolvedSchema.Value))
        {
            if (branch.TryGetProperty("enum", out var enumProp) && enumProp.ValueKind == JsonValueKind.Array)
            {
                var items = enumProp.EnumerateArray()
                    .Where(e => e.ValueKind == JsonValueKind.String)
                    .Select(e => e.GetString())
                    .ToList();
                if (items.Count == 1 && string.Equals(items[0], choice, StringComparison.OrdinalIgnoreCase))
                {
                    await ValueChanged.InvokeAsync(ConfigPropertyValue.Literal(choice));
                    return;
                }
            }

            if (branch.TryGetProperty("properties", out var props) && props.ValueKind == JsonValueKind.Object)
            {
                var propList = props.EnumerateObject().ToList();
                if (propList.Count == 1 && string.Equals(propList[0].Name, choice, StringComparison.OrdinalIgnoreCase))
                {
                    var defaultValue = GetDefaultForSchema(propList[0].Value);
                    var payload = new Dictionary<string, object?>(StringComparer.Ordinal) { [choice] = defaultValue };
                    await ValueChanged.InvokeAsync(ConfigPropertyValue.Literal(payload));
                    return;
                }
            }
        }
    }

    private static object? GetDefaultForSchema(JsonElement schema)
    {
        string? type = null;
        if (schema.TryGetProperty("type", out var typeProp))
        {
            if (typeProp.ValueKind == JsonValueKind.String)
            {
                type = typeProp.GetString();
            }
            else if (typeProp.ValueKind == JsonValueKind.Array)
            {
                type = typeProp.EnumerateArray()
                    .Where(e => e.ValueKind == JsonValueKind.String &&
                        !string.Equals(e.GetString(), "null", StringComparison.OrdinalIgnoreCase))
                    .Select(e => e.GetString())
                    .FirstOrDefault();
            }
        }

        return type switch
        {
            "array" => new List<object?>(),
            "integer" or "number" => 0L,
            "object" => new Dictionary<string, object?>(),
            "boolean" => false,
            _ => string.Empty
        };
    }

    private JsonElement? ResolveSchema(JsonElement? schema)
    {
        if (!schema.HasValue)
        {
            return null;
        }

        if (schema.Value.TryGetProperty("$ref", out var refProp) &&
            refProp.ValueKind == JsonValueKind.String &&
            !string.IsNullOrWhiteSpace(RootSchemaJson))
        {
            var refPath = refProp.GetString()!;

            if (refPath.StartsWith("#/"))
            {
                try
                {
                    using var doc = JsonDocument.Parse(RootSchemaJson);
                    var parts = refPath[2..].Split('/');

                    var current = doc.RootElement;
                    foreach (var part in parts)
                    {
                        var decoded = Uri.UnescapeDataString(part.Replace("~1", "/").Replace("~0", "~"));
                        if (!current.TryGetProperty(decoded, out current))
                        {
                            return null;
                        }
                    }
                    return current.Clone();
                }
                catch
                {
                    return null;
                }
            }
        }

        return schema;
    }

    private static JsonElement[] GetOneOfBranches(JsonElement schema)
    {
        if (schema.TryGetProperty("oneOf", out var oneOf) && oneOf.ValueKind == JsonValueKind.Array)
        {
            return oneOf.EnumerateArray().ToArray();
        }

        if (schema.TryGetProperty("anyOf", out var anyOf) && anyOf.ValueKind == JsonValueKind.Array)
        {
            return anyOf.EnumerateArray().ToArray();
        }

        return [];
    }

    private static string GetFunctionSummary(DscFunctionExpression expression)
    {
        var nestedCount = CountNestedFunctions(expression);
        return nestedCount > 0
            ? $"{expression.FunctionName} ({nestedCount} nested)"
            : expression.FunctionName;
    }

    private static int CountNestedFunctions(DscFunctionExpression expression)
    {
        return expression.Args
            .Where(a => a.IsNested && a.NestedFunction is not null)
            .Sum(a => 1 + CountNestedFunctions(a.NestedFunction!));
    }
}

