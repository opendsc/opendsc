@rendermode InteractiveServer

@using OpenDsc.Contracts.ResourceManifests
@using OpenDsc.Server.Services

@inject IResourceManifestService ManifestService

<MudDialog>
    <DialogContent>
        <MudStack>
            <MudAutocomplete T="string" Label="Resource type" Variant="Variant.Outlined" Value="@_type"
                             SearchFunc="SearchManifests" ValueChanged="@(v => _type = v)" CoerceValue="false"
                             ResetValueOnEmptyText="false" Immediate="true" OpenOnFocus="true" MaxItems="5000"
                             Placeholder="Search by type name or description">
                <ItemTemplate Context="manifest">
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.body2">@manifest</MudText>
                    </div>
                </ItemTemplate>
            </MudAutocomplete>

            <MudTextField T="string" Label="Instance name" @bind-Value="_name" Variant="Variant.Outlined"
                          Immediate="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm"
                   Disabled="@(string.IsNullOrWhiteSpace(_type))">
            Add
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string DefaultName { get; set; } = string.Empty;

    [Parameter]
    public string? DefaultType { get; set; }

    private string _type = string.Empty;
    private string _name = string.Empty;
    private List<ResourceManifestSummary> _manifests = [];

    protected override async Task OnInitializedAsync()
    {
        _name = DefaultName;
        _type = DefaultType ?? string.Empty;
        _manifests = (await ManifestService.GetAllAsync())
            .OrderBy(m => m.TypeName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private Task<IEnumerable<string>> SearchManifests(string value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult(_manifests.Select(m => m.TypeName).AsEnumerable());
        }

        var results = _manifests
            .Where(m => m.TypeName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                       (m.Description?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false))
            .Select(m => m.TypeName);

        return Task.FromResult(results);
    }

    private void Cancel() => MudDialog.Cancel();

    private void Confirm()
    {
        MudDialog.Close(DialogResult.Ok((_type, _name)));
    }
}
