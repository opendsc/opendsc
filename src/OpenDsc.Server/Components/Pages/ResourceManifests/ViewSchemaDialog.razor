@rendermode InteractiveServer

@using BlazorMonaco.Editor
@using System.Text.Json
@using System.Text.Json.Nodes
@using YamlDotNet.Serialization
@inject ThemeService ThemeService

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="false" ActivePanelIndex="0">
            <MudTabPanel Text="YAML">
                <div style="height: 60vh; width: 100%; border: 1px solid var(--mud-palette-lines-default);">
                    <StandaloneCodeEditor Id="schema-yaml-editor" ConstructionOptions="YamlEditorOptions"
                                          CssClass="file-viewer-editor" />
                </div>
            </MudTabPanel>
            <MudTabPanel Text="JSON">
                <div style="height: 60vh; width: 100%; border: 1px solid var(--mud-palette-lines-default);">
                    <StandaloneCodeEditor Id="schema-json-editor" ConstructionOptions="JsonEditorOptions"
                                          CssClass="file-viewer-editor" />
                </div>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string SchemaJson { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = "Schema";

    private string PrettyJson => TryPrettyJson(SchemaJson);

    private string PrettyYaml => TryPrettyYaml(SchemaJson);

    private StandaloneEditorConstructionOptions YamlEditorOptions(StandaloneCodeEditor editor) =>
        new()
        {
            Language = "yaml",
            ReadOnly = true,
            Value = PrettyYaml,
            Theme = ThemeService.IsDarkMode ? "vs-dark" : "vs",
            AutomaticLayout = true,
            Minimap = new EditorMinimapOptions { Enabled = false },
            ScrollBeyondLastLine = false
        };

    private StandaloneEditorConstructionOptions JsonEditorOptions(StandaloneCodeEditor editor) =>
        new()
        {
            Language = "json",
            ReadOnly = true,
            Value = PrettyJson,
            Theme = ThemeService.IsDarkMode ? "vs-dark" : "vs",
            AutomaticLayout = true,
            Minimap = new EditorMinimapOptions { Enabled = false },
            ScrollBeyondLastLine = false
        };

    private static string TryPrettyJson(string json)
    {
        try
        {
            var node = JsonNode.Parse(json);
            return node?.ToJsonString(new JsonSerializerOptions { WriteIndented = true }) ?? json;
        }
        catch
        {
            return json;
        }
    }

    private static string TryPrettyYaml(string json)
    {
        try
        {
            var node = JsonNode.Parse(json);
            if (node is null)
            {
                return string.Empty;
            }

            var native = ConvertNode(node);
            var serializer = new SerializerBuilder().Build();
            return serializer.Serialize(native);
        }
        catch
        {
            return json;
        }
    }

    private static object? ConvertNode(JsonNode? node) => node switch
    {
        null => null,
        JsonValue value => value.TryGetValue<bool>(out var b) ? b
            : value.TryGetValue<long>(out var l) ? l
            : value.TryGetValue<double>(out var d) ? d
            : value.TryGetValue<string>(out var s) ? s
            : value.ToJsonString(),
        JsonObject obj => obj.ToDictionary(kvp => kvp.Key, kvp => ConvertNode(kvp.Value)),
        JsonArray arr => arr.Select(ConvertNode).ToList(),
        _ => node.ToJsonString()
    };
}
