@rendermode InteractiveServer

@using MudBlazor
@using BlazorMonaco
@using BlazorMonaco.Editor
@using NuGet.Versioning
@using OpenDsc.Contracts.Parameters
@using OpenDsc.Server.Services
@inject IParameterService ParameterService
@inject ISnackbar Snackbar
@inject ThemeService ThemeService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Editing draft version @ParameterVersion
        </MudText>

        <MudText Typo="Typo.subtitle2" Class="mb-2">Parameter Content (YAML)</MudText>
        @if (isLoading)
        {
            <MudProgressCircular Indeterminate="true" />
            <MudText Typo="Typo.caption">Loading parameter content...</MudText>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_tabSwitchError))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@_tabSwitchError</MudAlert>
            }

            @if (currentSchema == null || string.IsNullOrWhiteSpace(currentSchema.GeneratedJsonSchema))
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    No parameter schema found for this version. YAML mode is used for editing.
                </MudAlert>

                <div style="height: 500px; width: 100%; border: 1px solid var(--mud-palette-lines-default);">
                    <StandaloneCodeEditor @ref="_editor" Id="parameter-edit-editor" ConstructionOptions="GetEditorOptions"
                                          CssClass="monaco-editor-container" />
                </div>
            }
            else
            {
                <MudTabs Elevation="0" Rounded="false" @bind-ActivePanelIndex="activeEditorTab"
                         @bind-ActivePanelIndex:after="OnEditorTabChanged">
                    <MudTabPanel Text="Form" Icon="@Icons.Material.Filled.Tune">
                        <ParameterFormEditor @ref="_formEditor" SchemaJson="@(currentSchema?.GeneratedJsonSchema)"
                                             YamlContent="@_formSourceYaml" FormStateChanged="OnFormStateChanged" />
                    </MudTabPanel>
                    <MudTabPanel Text="YAML" Icon="@Icons.Material.Filled.Code">
                        <div style="height: 500px; width: 100%; border: 1px solid var(--mud-palette-lines-default);">
                            <StandaloneCodeEditor @ref="_editor" Id="parameter-edit-editor"
                                                  ConstructionOptions="GetEditorOptions" CssClass="monaco-editor-container" />
                        </div>
                    </MudTabPanel>
                </MudTabs>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveParameter"
                   Disabled="@(isLoading || isSaving || _formHasValidationErrors)">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid ParameterId { get; set; }

    [Parameter]
    public Guid ScopeTypeId { get; set; }

    [Parameter]
    public Guid ConfigurationId { get; set; }

    [Parameter]
    public string? ScopeValue { get; set; }

    [Parameter]
    public string ParameterVersion { get; set; } = string.Empty;

    private StandaloneCodeEditor? _editor;
    private ParameterFormEditor? _formEditor;
    private string? initialContent;
    private ParameterSchemaDetails? currentSchema;
    private bool isLoading = true;
    private bool isSaving;
    private int activeEditorTab;
    private bool _formHasValidationErrors;
    private string? _tabSwitchError;
    private string? _formSourceYaml;

    protected override async Task OnInitializedAsync()
    {
        await LoadParameterContent();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isLoading || activeEditorTab != 0)
        {
            return;
        }

        if (_formEditor == null ||
            _formEditor.IsLoaded ||
            currentSchema == null ||
            string.IsNullOrWhiteSpace(currentSchema.GeneratedJsonSchema))
        {
            return;
        }

        var yaml = _editor == null ? initialContent ?? string.Empty : await _editor.GetValue();
        await _formEditor.LoadAsync(currentSchema.GeneratedJsonSchema, yaml);
        _formHasValidationErrors = _formEditor.HasValidationErrors;

        if (!_formEditor.IsLoaded)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadParameterContent()
    {
        isLoading = true;

        try
        {
            initialContent = await ParameterService.GetContentAsync(ParameterId);

            if (initialContent == null)
            {
                Snackbar.Add("Failed to load parameter content", Severity.Error);
                initialContent = "# Failed to load content";
            }

            _formSourceYaml = initialContent;

            await LoadSchemaForCurrentVersion();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSchemaForCurrentVersion()
    {
        currentSchema = null;

        if (!SemanticVersion.TryParse(ParameterVersion, out var semVer))
        {
            activeEditorTab = 1;
            return;
        }

        currentSchema = await ParameterService.GetSchemaAsync(ConfigurationId, semVer.Major);
        activeEditorTab = currentSchema != null && !string.IsNullOrWhiteSpace(currentSchema.GeneratedJsonSchema) ? 0 : 1;
    }

    private async Task OnEditorTabChanged()
    {
        _tabSwitchError = null;

        if (activeEditorTab == 0)
        {
            if (currentSchema == null || string.IsNullOrWhiteSpace(currentSchema.GeneratedJsonSchema))
            {
                _tabSwitchError = "Form editor requires a parameter schema for this parameter version.";
                activeEditorTab = 1;
                return;
            }

            if (_formEditor != null)
            {
                var yaml = _editor == null ? initialContent ?? string.Empty : await _editor.GetValue();
                _formSourceYaml = yaml;
                await _formEditor.LoadAsync(currentSchema.GeneratedJsonSchema, yaml);
                _formHasValidationErrors = _formEditor.HasValidationErrors;
            }

            return;
        }

        if (_formEditor is { IsLoaded: true })
        {
            var yaml = _formEditor.BuildYaml();
            initialContent = yaml;
            _formSourceYaml = yaml;

            // Set value if editor is already created; otherwise it will use initialContent when created
            if (_editor != null)
            {
                await _editor.SetValue(yaml);
            }
        }
    }

    private async Task OnFormStateChanged(bool hasValidationErrors)
    {
        _formHasValidationErrors = hasValidationErrors;
        await InvokeAsync(StateHasChanged);
    }

    private StandaloneEditorConstructionOptions GetEditorOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "yaml",
            Value = initialContent ?? "",
            Theme = ThemeService.IsDarkMode ? "vs-dark" : "vs",
            LineNumbers = "on",
            Minimap = new EditorMinimapOptions { Enabled = false },
            ScrollBeyondLastLine = false,
            FontSize = 14,
            FontFamily = "'Cascadia Code', 'Courier New', monospace",
            TabSize = 2,
            InsertSpaces = true,
            WordWrap = "off"
        };
    }

    private async Task SaveParameter()
    {
        if (_formHasValidationErrors)
        {
            return;
        }

        isSaving = true;

        try
        {
            string? content;
            if (activeEditorTab == 0 && _formEditor is { IsLoaded: true })
            {
                content = _formEditor.BuildYaml();
            }
            else
            {
                if (_editor == null)
                {
                    Snackbar.Add("Parameter editor is not ready. Please wait for the editor to load or switch tabs.", Severity.Warning);
                    return;
                }

                content = await _editor.GetValue();
            }

            if (string.IsNullOrWhiteSpace(content))
            {
                Snackbar.Add("Parameter content cannot be empty", Severity.Warning);
                return;
            }

            await ParameterService.UpdateAsync(
                ParameterId,
                new UpdateParameterRequest { Content = content });

            Snackbar.Add("Draft parameter saved", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
