@namespace OpenDsc.Server.Components.Pages
@using OpenDsc.Server.Authorization
@using OpenDsc.Contracts.Users
@using MudBlazor

<MudDialog>
    <DialogContent>
        @if (Token.IsRevoked)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                This token has been revoked and can no longer be used.
            </MudAlert>
        }

        @if (_scopeValues.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @(Token.IsRevoked ? "This token had no scopes assigned when it was revoked." : "This token has no scopes assigned.")
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.subtitle2" Class="mb-3">
                @(Token.IsRevoked ? "Scopes that were granted to this token:" : "Scopes granted to this token:")
            </MudText>
            <MudPaper Class="pa-3" Style="max-height: 400px; overflow-y: auto; border: 1px solid #e0e0e0;">
                <MudTreeView T="string" Items="@_treeItems" SelectedValues="_selectedScopes"
                             SelectionMode="SelectionMode.MultiSelection" CheckBoxColor="Color.Primary">
                    <ItemTemplate Context="item">
                        <MudTreeViewItem T="string" Expanded="_expandedItems.Contains(item.Value!)"
                                         ExpandedChanged="@((bool e) => UpdateExpanded(item.Value!, e))" Items="item.Children"
                                         Value="item.Value" Text="@item.Text" Disabled="true" />
                    </ItemTemplate>
                </MudTreeView>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public TokenMetadata Token { get; set; } = default!;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private List<string> _scopeValues = [];
    private List<TreeItemData<string>> _treeItems = [];
    private HashSet<string> _selectedScopes = [];
    private HashSet<string> _expandedItems = [];

    protected override void OnParametersSet()
    {
        _scopeValues = Token.Scopes?.ToList() ?? [];

        _treeItems = PermissionHierarchyHelper.CreateTreeData(Permissions.AllScopes, _scopeValues);
        _selectedScopes = new HashSet<string>(_scopeValues, StringComparer.Ordinal);
        // Expand all items by default in readonly view
        _expandedItems = GetAllTreeItemValues(_treeItems);
    }

    private HashSet<string> GetAllTreeItemValues(List<TreeItemData<string>> items)
    {
        var expanded = new HashSet<string>(StringComparer.Ordinal);
        foreach (var item in items)
        {
            if (item.Value != null)
            {
                expanded.Add(item.Value);
            }
            if (item.Children?.Count > 0)
            {
                var childExpanded = GetAllTreeItemValues(item.Children);
                foreach (var child in childExpanded)
                {
                    expanded.Add(child);
                }
            }
        }
        return expanded;
    }

    private void UpdateExpanded(string value, bool expanded)
    {
        if (expanded)
            _expandedItems.Add(value);
        else
            _expandedItems.Remove(value);
    }

    private void Close() => MudDialog.Close();
}
